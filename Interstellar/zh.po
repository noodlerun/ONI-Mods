msgctxt "Interstellar.BUILDINGS.PREFABS.ENGINECONSOLE.NAME"
msgid "<link=ENGINECONSOLE\">Asteroid Engine Console</link>"
msgstr "<link=ENGINECONSOLE\">小行星引擎控制台</link>"

msgctxt "Interstellar.BUILDINGS.PREFABS.ENGINECONSOLE.DESC"
msgid "Asteroid Engine Console Description"
msgstr "只允许在主星建造，并且只能建造一个。可以控制多个行星引擎"

msgctxt "Interstellar.BUILDINGS.PREFABS.ENGINECONSOLE.EFFECT"
msgid "Star Engine Console Effect details"
msgstr "行星引擎控制台拥有四个档位，可以控制<link=\"ASTEROIDENGINE\">行星引擎</link>的输出功率。挡位一：功耗0，引擎停止运动。档位二：功耗25Kw。档位三：功耗35Kw。挡位四：功耗45Kw"

msgctxt "Interstellar.BUILDINGS.PREFABS.ASTEROIDENGINE.NAME"
msgid "<link=ASTEROIDENGINE\">Asteroid Engine</link>"
msgstr "<link=ASTEROIDENGINE\">小行星引擎</link>"

msgctxt "Interstellar.BUILDINGS.PREFABS.ASTEROIDENGINE.DESC"
msgid "Asteroid Engine Console Description"
msgstr "只允许在主星建造，并且只能建造在小行星底部(高小于离底部30格)"

msgctxt "Interstellar.BUILDINGS.PREFABS.ASTEROIDENGINE.EFFECT"
msgid "Asteroid Engine Effect details"
msgstr "由<link=\"ENGINECONSOLE\">行星引擎控制台</link>进行全面的控制，可以推动小行星前进"

